pipeline {

    agent any

    tools { 
        maven 'maven3' 
    }

    options {
        buildDiscarder logRotator( 
            daysToKeepStr: '15', 
            numToKeepStr: '10'
        )
    }

    environment {
        APP_NAME = "STUDENT_APP"
        APP_ENV  = "DEV"
    }

    stages {
        
        stage('Cleanup Workspace') {
            steps {
                cleanWs()
                sh """
                echo "Cleaned Up Workspace for ${APP_NAME}"
                """
            }
        }

        stage('Code Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'https://github.com/MunSka/8363488A-dv1c03-repo.git']]
                ])
            }
        }

        stage('8363488A-S1') {
            steps {
                sh """
                echo "8363488A-S1: Release environment is ready."
                """
            }
        }
        stage('8363488A-S2') {
            steps {
                sh """
                echo "8363488A-S2: Release Windows checked - Continue the pipeline."
                """
            }
        }
        stage('8363488A-S3') {
            steps {
                sh """
                echo "8363488A-S3: Web Server is setup and running"
                docker ps --filter "name=8363488A-web-server"
                """
            }
        }
stage('8363488A-parallel-S4') {
    parallel {
        stage('8363488A-S4A') {
            steps {
                sh '''
                echo "8363488A-S4A: SQL Injection (SQLi) Test – Report Generated"
                '''
            }
        }

        stage('8363488A-S4B') {
            steps {
                sh '''
                echo "8363488A-S4B: Cross-Site Scripting (XSS) Test – Report Generated"
                '''
            }
        }

    }
}
stage('8363488A-S5') {
    steps {
        script {
            def userInput = input(
                message: '8363488A, after checking security reports, continue the pipeline?',
                parameters: [
                    [$class: 'ChoiceParameterDefinition', 
                     choices: "Proceed\nAbort", 
                     description: 'Select an action', 
                     name: 'ACTION']
                ]
            )
            
            if (userInput == 'Proceed') {
                echo "8363488A-S5: Approve to continue the pipeline."
                // Set a flag to allow next stage
                currentBuild.description = "Proceed"
            } else {
                echo "Pipeline aborted by user."
                error("User selected Abort") // aborts pipeline
            }
        }
    }
}

stage('8363488A-S6') {
    when {
        expression { return currentBuild.description == "Proceed" }
    }
    steps {
        sh """
        echo "8363488A-S6: Getting ready for next phase"
        """
    }
}
        
    }
}
